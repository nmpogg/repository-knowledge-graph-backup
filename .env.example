# Copy to .env at the repository root. Keep the two session values identical.
# The RKG CLI loads server settings; Vite reads the VITE_ settings.
# Never commit real credentials or a customized session token.
RKG_SESSION_TOKEN=local-session
VITE_RKG_SESSION=local-session
VITE_RKG_CLIENT=live

# Ask provider: openrouter (default) or openai; settings are server-only.
RKG_LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# Direct OpenAI: set RKG_LLM_PROVIDER=openai and fill OPENAI_API_KEY.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
