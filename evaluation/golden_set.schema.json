{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Source-backed chatbot golden set v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "dataset_id", "revision", "authority", "authoring_status", "independent_review_status", "created_date", "expected_case_count", "policy_references", "binding", "scoring", "repositories", "cases"],
  "properties": {
    "schema_version": {"const": "rkg.chatbot-golden/1"},
    "dataset_id": {"const": "RKG-CHATBOT-GOLDEN-001"},
    "revision": {"type": "integer", "minimum": 1},
    "authority": {"const": "non_normative_evaluation_fixture"},
    "authoring_status": {"const": "source_checked"},
    "independent_review_status": {"enum": ["pending", "approved"]},
    "created_date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "expected_case_count": {"const": 50},
    "policy_references": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "binding": {"type": "object", "additionalProperties": {"type": "string"}, "required": ["snapshot_ids", "graph_preflight", "primary_metric", "status_notes"]},
    "scoring": {
      "type": "object", "additionalProperties": false,
      "required": ["answerable_accuracy_target", "citation_coverage_target", "citation_validity_target", "graph_contradiction_target", "safety_pass_target", "conversation_pass_target", "all_required_facts_must_pass", "verbatim_answer_match", "readability_checks"],
      "properties": {
        "answerable_accuracy_target": {"const": 0.9},
        "citation_coverage_target": {"const": 1.0},
        "citation_validity_target": {"const": 1.0},
        "graph_contradiction_target": {"const": 0},
        "safety_pass_target": {"const": 1.0},
        "conversation_pass_target": {"const": 1.0},
        "all_required_facts_must_pass": {"const": true},
        "verbatim_answer_match": {"const": false},
        "readability_checks": {"$ref": "#/$defs/strings"}
      }
    },
    "repositories": {
      "type": "object", "minProperties": 6, "maxProperties": 6,
      "additionalProperties": {
        "type": "object", "additionalProperties": false,
        "required": ["root", "stack", "source_manifest_sha256", "files"],
        "properties": {
          "root": {"type": "string"}, "stack": {"type": "string"},
          "source_manifest_sha256": {"$ref": "#/$defs/hash"},
          "files": {"type": "object", "minProperties": 1, "additionalProperties": {"$ref": "#/$defs/hash"}}
        }
      }
    },
    "cases": {"type": "array", "minItems": 50, "maxItems": 50, "items": {"$ref": "#/$defs/case"}}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "strings": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "path", "start_line", "end_line", "file_sha256", "span_sha256"],
      "properties": {
        "id": {"type": "string", "pattern": "^S[1-9][0-9]*$"}, "path": {"type": "string", "minLength": 1},
        "start_line": {"type": "integer", "minimum": 1}, "end_line": {"type": "integer", "minimum": 1},
        "file_sha256": {"$ref": "#/$defs/hash"}, "span_sha256": {"$ref": "#/$defs/hash"}
      }
    },
    "fact": {
      "type": "object", "additionalProperties": false, "required": ["id", "claim", "source_ids"],
      "properties": {
        "id": {"type": "string", "pattern": "^T[1-9][0-9]*-F[1-9][0-9]*$"},
        "claim": {"type": "string", "minLength": 1},
        "source_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}
      }
    },
    "turn": {
      "type": "object", "additionalProperties": false, "required": ["turn_id", "session", "question", "expected"],
      "properties": {
        "turn_id": {"type": "string", "pattern": "^T[1-9][0-9]*$"},
        "session": {"type": "string", "minLength": 1}, "question": {"type": "string", "minLength": 1},
        "selection": {
          "type": "object", "additionalProperties": false, "required": ["entity_type", "symbol", "path"],
          "properties": {"entity_type": {"type": "string"}, "symbol": {"type": "string", "minLength": 1}, "path": {"type": "string", "minLength": 1}}
        },
        "expected": {
          "type": "object", "additionalProperties": false,
          "required": ["status", "required_facts", "forbidden_claims", "required_metadata", "checks"],
          "properties": {
            "status": {"enum": ["answered", "needs_clarification", "insufficient_evidence"]},
            "required_facts": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/fact"}},
            "forbidden_claims": {"$ref": "#/$defs/strings"}, "checks": {"$ref": "#/$defs/strings"},
            "required_metadata": {"type": "object", "additionalProperties": {"type": "boolean"}}
          }
        }
      }
    },
    "case": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "repository", "category", "feature", "evaluation_scope", "notes", "question_variants", "turns", "sources"],
      "properties": {
        "id": {"type": "string", "pattern": "^RKG-EVAL-[0-9]{3}$"}, "repository": {"type": "string"},
        "category": {"enum": ["answerable", "insufficient", "ambiguous", "safety", "conversation", "long_conversation"]},
        "feature": {"type": "string", "minLength": 1}, "evaluation_scope": {"const": "source_backed_product"},
        "notes": {"type": "string"}, "question_variants": {"$ref": "#/$defs/strings"},
        "turns": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/turn"}},
        "sources": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/source"}}
      }
    }
  }
}
